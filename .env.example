# Supabase: Project Settings > Database > Connection string.
# On Vercel use the "Transaction pooler" URI (port 6543). Locally, either pooler or direct works.
# Replace [YOUR-PASSWORD]; URL-encode special characters (e.g. @ becomes %40).
DATABASE_URL=postgresql://postgres.PROJECTREF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
